---
/*
 * Conmutador de tema con la forma exacta del sitio: un botón cuadrado de 38px con
 * un sol o una luna, no el desplegable de Starlight.
 *
 * Reemplaza a ThemeSelect por la anulación de componentes de Starlight. El script
 * que Starlight pone en el <head> sigue siendo el que decide el tema inicial: lee
 * `starlight-theme` de localStorage y, si no hay nada guardado, cae a
 * prefers-color-scheme. Este botón solo escribe ahí, así que la detección
 * automática del sistema se conserva.
 *
 * Los dos iconos son los mismos de front/src/App.jsx, con el mismo trazo de 1,7.
 */
const etiquetas = {
  es: { aOscuro: 'Cambiar a modo oscuro', aClaro: 'Cambiar a modo claro' },
  en: { aOscuro: 'Switch to dark mode', aClaro: 'Switch to light mode' },
};
const lang = Astro.currentLocale === 'es' ? 'es' : 'en';
const t = etiquetas[lang];
---

<button
  class="moonin-toggle"
  type="button"
  data-moonin-tema
  aria-label={t.aOscuro}
  data-label-oscuro={t.aOscuro}
  data-label-claro={t.aClaro}
>
  <svg class="icono-sol" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="4.2"></circle>
    <path
      d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M18.4 5.6L17 7M7 17l-1.4 1.4"
    ></path>
  </svg>
  <svg class="icono-luna" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M20.5 14.6A8.6 8.6 0 1 1 9.4 3.5a7 7 0 0 0 11.1 11.1z"></path>
  </svg>
</button>

<script is:inline>
  /*
   * Starlight renderiza este componente DOS veces: una en el encabezado de
   * escritorio y otra en el menu movil. Con ello el script tambien sale dos veces,
   * asi que hace falta cuidar dos cosas:
   *
   *   1. enlazar TODOS los botones y no solo el primero, o el del menu movil queda
   *      muerto
   *   2. no enlazar dos veces el mismo boton: la primera version usaba
   *      querySelector y las dos copias del script cargaban el mismo elemento, de
   *      modo que cada clic alternaba dos veces y volvia al punto de partida. Se
   *      veia como que el boton no hacia nada.
   *
   * De ahi el centinela en window y la marca por elemento.
   */
  (function () {
    if (window.__mooninTema) return;
    window.__mooninTema = true;

    var CLAVE = 'starlight-theme';

    function actual() {
      var g = null;
      try {
        g = localStorage.getItem(CLAVE);
      } catch (e) {}
      if (g === 'dark' || g === 'light') return g;
      return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    }

    function pintar(tema) {
      document.documentElement.dataset.theme = tema;
      var todos = document.querySelectorAll('[data-moonin-tema]');
      for (var i = 0; i < todos.length; i++) {
        var b = todos[i];
        var l = tema === 'dark' ? b.dataset.labelClaro : b.dataset.labelOscuro;
        b.setAttribute('aria-label', l);
        b.setAttribute('title', l);
      }
    }

    function enlazar() {
      var todos = document.querySelectorAll('[data-moonin-tema]');
      for (var i = 0; i < todos.length; i++) {
        var b = todos[i];
        if (b.dataset.mooninEnlazado) continue;
        b.dataset.mooninEnlazado = '1';
        b.addEventListener('click', function () {
          var nuevo = actual() === 'dark' ? 'light' : 'dark';
          try {
            localStorage.setItem(CLAVE, nuevo);
          } catch (e) {}
          pintar(nuevo);
        });
      }
      pintar(actual());
    }

    enlazar();
    document.addEventListener('DOMContentLoaded', enlazar);
    /* Starlight puede navegar sin recargar. */
    document.addEventListener('astro:page-load', enlazar);

    /* Si el usuario no ha elegido, seguir al sistema cuando cambie. */
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function (e) {
      var g = null;
      try {
        g = localStorage.getItem(CLAVE);
      } catch (_) {}
      if (g !== 'dark' && g !== 'light') pintar(e.matches ? 'dark' : 'light');
    });
  })();
</script>
