---
/*
 * Conmutador de idioma con la forma exacta del sitio: un botón que muestra el
 * idioma DESTINO —«EN» estando en español, «ES» estando en inglés— en vez del
 * desplegable de Starlight.
 *
 * Reemplaza a LanguageSelect por la anulación de componentes.
 *
 * El destino se calcula de la ruta y no de las entrañas de Starlight: el español
 * vive bajo /es/ y el inglés en la raíz, así que quitar o poner ese prefijo basta y
 * funciona igual en cualquier página.
 */
const ruta = Astro.url.pathname;
const enEspanol = ruta === '/es' || ruta.startsWith('/es/');
const destino = enEspanol ? ruta.replace(/^\/es(?=\/|$)/, '') || '/' : `/es${ruta}`;
const codigo = enEspanol ? 'EN' : 'ES';
const etiqueta = enEspanol ? 'View documentation in English' : 'Ver documentación en español';
---

<a
  class="moonin-lang"
  href={destino}
  aria-label={etiqueta}
  title={etiqueta}
  lang={enEspanol ? 'en' : 'es'}
  data-moonin-idioma>{codigo}</a
>

<script is:inline>
  /* Igual que el de tema: Starlight renderiza esto dos veces, en el encabezado y en
     el menu movil, asi que hay que enlazar todos y una sola vez cada uno. */
  (function () {
    if (window.__mooninIdioma) return;
    window.__mooninIdioma = true;
    function enlazar() {
      var todos = document.querySelectorAll('[data-moonin-idioma]');
      for (var i = 0; i < todos.length; i++) {
        var a = todos[i];
        if (a.dataset.mooninEnlazado) continue;
        a.dataset.mooninEnlazado = '1';
        a.addEventListener('click', function (ev) {
          try {
            localStorage.setItem(
              'moonin-docs-lang',
              ev.currentTarget.getAttribute('lang') === 'es' ? 'es' : 'en',
            );
          } catch (e) {}
        });
      }
    }
    enlazar();
    document.addEventListener('DOMContentLoaded', enlazar);
    document.addEventListener('astro:page-load', enlazar);
  })();
</script>
